[gd_scene format=3]

[ext_resource type="Theme" path="res://resources/themes/mobile.tres" id="1_theme"]
[ext_resource type="Script" path="res://scripts/mobile/ui/views/MobileViewBase.cs" id="2_script"]
[ext_resource type="Texture2D" path="res://assets/textures/ui-icons/shopping-cart.svg" id="3_icon"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.101960786, 0.19215687, 0.3019608, 1)
content_margin_left = 24.0
content_margin_top = 24.0
content_margin_right = 24.0
content_margin_bottom = 24.0

[node name="StorePlaceholder" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_theme")
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")
script = ExtResource("2_script")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="Icon" type="TextureRect" parent="Layout"]
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
texture = ExtResource("3_icon")
expand_mode = 1
stretch_mode = 5

[node name="Title" type="Label" parent="Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Store"
horizontal_alignment = 1

[node name="Body" type="Label" parent="Layout"]
layout_mode = 2
text = "Offline preview placeholder. Store API and purchase flows are not wired into this Android UI shell yet."
horizontal_alignment = 1
autowrap_mode = 3
